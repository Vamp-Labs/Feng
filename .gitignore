# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# foundry artifacts
/broadcast/
/cache/

# misc
.DS_Store
*.pem
*.key
*.keystore
/keystore/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# frontend-owned local anvil fixture (dev/fixture/) — build artifacts only, not the .sol sources
dev/fixture/out/
dev/fixture/cache/
dev/fixture/broadcast/

# keeper and ops logs
*.log
/logs/
keeper*.out
ops-worker*.out

# local agent settings
/.claude/settings.local.json
